# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ── Observe: LangSmith tracing ────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_PROJECT=payer-claims-agent
# LANGSMITH_WORKSPACE_ID=your-workspace-id      # only for org-scoped keys

# PHI safety: inputs/outputs are masked in traces by default. Set to true ONLY
# in a trusted, compliant environment where sending member PHI to LangSmith is
# permitted. Leave unset (masked) otherwise.
# LANGSMITH_UNMASK_PHI=false

# ── LLM intake node (claude-sonnet-5) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_api_key_here
