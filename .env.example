# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ── Observe: LangSmith tracing ────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_PROJECT=payer-claims-agent
# LANGSMITH_WORKSPACE_ID=your-workspace-id      # only for org-scoped keys

# PHI safety: run inputs/outputs are captured but member PHI is redacted at the
# field level by default. Set to true ONLY in a trusted, compliant environment
# where sending raw, unredacted member PHI to LangSmith is permitted. Leave
# unset (redacted) otherwise.
# LANGSMITH_UNMASK_PHI=false

# Adjuster identity for per-adjuster trace filtering (root-run metadata.user_id).
# CLAIMS_ADJUSTER_ID=demo-adjuster

# ── LLM intake node (claude-sonnet-5) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_api_key_here
